<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened runtime: allow access to Calendar and Contacts via TCC -->
    <key>com.apple.security.personal-information.calendars</key>
    <true/>
    <key>com.apple.security.personal-information.contacts</key>
    <true/>
    <!-- Allow JIT compilation — required by Wasmtime for CodeAct WASM execution.
         Wasmtime 29.x uses mprotect(PROT_EXEC) on anonymous pages (not MAP_JIT),
         so allow-unsigned-executable-memory is the operative entitlement.
         allow-jit is kept for forward-compatibility if Wasmtime adopts MAP_JIT. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
</dict>
</plist>
